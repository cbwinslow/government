# Government Pipeline — .gitignore

# Environment
.env
*.env.local
.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environment
pipeline-venv/
venv/
.venv/

# Python version file
.python-version

# Package managers
uv.lock

# Data (large files — never commit)
data/raw/*
data/processed/*
data/embeddings/*
data/exports/*
data/databases/*
data/gdelt/
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/embeddings/.gitkeep
!data/exports/.gitkeep

# LLM server artifacts
llama/embed-server.log
llama/embed-server.pid

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json

# VS Code MCP (contains local paths)
.vscode/mcp.json

# Large downloaded repos
Epstein-Files/
Epstein-research-data/

# Node
node_modules/

# AI tooling directories
.autoclaw/
.kilocode/
.refact/
.specstory/
.repowise/
.repowise-workspace.yaml

# Crush database and logs
.crush/

# Application logs
*.log
logs/
gov_transformations/logs/

# Data directories
epstein/data/
epstein/output/
financial-disclosures/
fec_bulk_data

# Backups and archives
*.tar.gz
*.zip

# Submodules and external repos
congress/
openstates-monorepo/

# Config files with local paths
config/ingestion_ledger.json
config/models.yaml

# Generated data
dox/
gov_transformations/target/

# Local example configs
gov-skills/configs/.env.example
politician-finance-pack/configs/.env.example