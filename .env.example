# Copy this file to .env. Never commit real credentials.
OPENDISCOURSE_ENVIRONMENT=development
OPENDISCOURSE_LOG_LEVEL=INFO
OPENDISCOURSE_CONFIG_FILE=config/default.toml

OPENDISCOURSE_DATABASE__DSN=postgresql+psycopg://opendiscourse:opendiscourse@localhost:5432/opendiscourse
OPENDISCOURSE_STORAGE__ROOT=./data
OPENDISCOURSE_STORAGE__TEMP_ROOT=./data/.tmp
OPENDISCOURSE_HTTP__TIMEOUT_SECONDS=60
OPENDISCOURSE_HTTP__MAX_RETRIES=5
OPENDISCOURSE_INGESTION__DOWNLOAD_CONCURRENCY=8

# Source credentials (leave blank until the corresponding adapter is enabled)
OPENDISCOURSE_SOURCES__GOVINFO_API_KEY=
OPENDISCOURSE_SOURCES__CONGRESS_API_KEY=
OPENDISCOURSE_SOURCES__FEC_API_KEY=
OPENDISCOURSE_SOURCES__CENSUS_API_KEY=
OPENDISCOURSE_SOURCES__FRED_API_KEY=
OPENDISCOURSE_SOURCES__OPENSTATES_API_KEY=
